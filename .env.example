# ============================================================
# Configuracion de la aplicacion
# Copiar como .env y ajustar los valores.
# ============================================================

# Conexion a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=students_db
DB_USER=students_user
DB_PASSWORD=students123

# Configuracion del servidor (modo sin Docker)
# Puerto HTTP del host donde se expone la aplicacion en Docker
# (el modo local usa Apache en 80). Se uso 8080 para no chocar con el
# Apache local de WSL.
APP_PORT=8080
